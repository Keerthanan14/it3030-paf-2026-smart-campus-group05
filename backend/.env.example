# ==========================================
# SMART CAMPUS API - ENVIRONMENT VARIABLES
# ==========================================
# This file is for your local development environment.
# DO NOT commit this file to GitHub! (.gitignore should exclude .env)
# Create a copy of this file and name it .env for local testing

# ------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------
# DB_URL=jdbc:postgresql://localhost:5432/smartcampus
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# Hibernate DDL Auto (update, create, create-drop, validate, none)
# DB_DDL_AUTO=update
# DB_SHOW_SQL=true

# ------------------------------------------
# 2. JWT (JSON Web Token) SECURITY
# ------------------------------------------
# The secret key must be at least 32 characters long.
JWT_SECRET=example-super-long-jwt-secret-key-change-me-before-production-2026

# Access Token expiration: 15 minutes (900000 ms)
JWT_EXPIRATION_MS=900000

# Refresh Token expiration: 7 days (604800000 ms)
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------
# 3. OAUTH2 (GOOGLE SIGN-IN) CONFIGURATION
# ------------------------------------------
# Get these from your Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Where the backend should redirect back to your React frontend after Google login
# FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/oauth2/callback

# ------------------------------------------
# 4. EMAIL CONFIGURATION (SMTP)
# ------------------------------------------
# Set MAIL_ENABLED=true if you want to actually send emails (e.g. verification codes)
MAIL_ENABLED=false
# MAIL_FROM=noreply@smartcampus.local
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587

# Your Gmail address used to send emails
# MAIL_USERNAME=your-email@gmail.com
# An "App Password" generated in your Google Account Security settings (NOT your main password)
# MAIL_PASSWORD=your-google-app-password

# ------------------------------------------
# 5. AUTHENTICATION & DIAGNOSTICS
# ------------------------------------------
# Turn on advanced logging for Auth debugging
AUTH_DEBUG=false
# How long email verification codes stay valid
# AUTH_VERIFICATION_CODE_TTL_MINUTES=10
# Enable startup creation of local test users (admin/technician/student)
SEED_TEST_USERS=false
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
