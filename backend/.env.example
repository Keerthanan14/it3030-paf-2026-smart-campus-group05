# Backend PostgreSQL settings
DB_URL=jdbc:postgresql://localhost:5432/smartcampus
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JPA settings
DB_DDL_AUTO=update
DB_SHOW_SQL=true

# JWT settings (HS256 requires at least 32 bytes / 256 bits)
JWT_SECRET=example-super-long-jwt-secret-key-change-me-before-production-2026
JWT_EXPIRATION_MS=86400000
JWT_EXAMPLE_TOKEN=eyJhbGciOiJIUzI1NiJ9.example.payload.signature

# OAuth2 + auth debug
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/oauth2/callback
AUTH_DEBUG=true

# Registration flow settings
AUTH_VERIFICATION_CODE_TTL_MINUTES=10

# SMTP mail settings
MAIL_ENABLED=false
MAIL_FROM=noreply@smartcampus.local
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
