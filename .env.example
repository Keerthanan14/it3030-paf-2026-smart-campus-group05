# ==========================================
# SMART CAMPUS UI - ENVIRONMENT VARIABLES
# ==========================================
# This file configures your local Vite React development environment.
# Note: Vite completely ignores any variable that doesn't start with "VITE_"

# ------------------------------------------
# 1. PLATFORM URLS
# ------------------------------------------
# The base URL where your Spring Boot backend runs
VITE_API_BASE_URL=http://localhost:8080
# The WebSocket URL for real-time notifications
VITE_WS_BASE_URL=ws://localhost:8080/ws
# The endpoint to redirect users to when they click "Sign in with Google"
VITE_OAUTH_START_URL=http://localhost:8080/oauth2/authorization/google

# ------------------------------------------
# 2. LOCAL STORAGE KEYS & DEBUGGING
# ------------------------------------------
# Show detailed auth logs in the browser console
VITE_AUTH_DEBUG=false
# The exact key used to save the 15-minute Access Token in localStorage
VITE_JWT_STORAGE_KEY=smartcampus_auth_token
